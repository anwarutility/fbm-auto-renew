{
  "manifest_version": 2,
  "name": "FB Marketplace Auto Renew",
  "version": "0.2.0",
  "description": "Posting iklan baru (semi-otomatis) + auto-renew listing Facebook Marketplace saat FB mengizinkan.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fbm-auto-renew@example.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "https://*.facebook.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/marketplace/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "FB Marketplace Auto Renew",
    "default_popup": "popup.html"
  }
}
